@using PagedList
@using PagedList.Mvc
@model IPagedList<ESIntegrateSys.Services.Dtos.QuoteDataListDto>

@{
    ViewBag.Title = "報價機種一覽";
    string dept = ViewBag.DeptNo;
}
<head>
    <style>
        .inline-form label, .inline-form select, .inline-form input, .inline-form button, .inline-form .form-check {
            display: inline-block;
            margin-right: 5px;
            vertical-align: middle;
        }

        .inline-form .form-control {
            display: inline-block;
            width: auto;
        }

        /* Bootstrap 預設在停用按鈕加 pointer-events: none，滑鼠事件會直接穿透到底下元素，
           cursor 樣式因此不會生效（會顯示底層元素的游標）；改回 auto 才能讓 cursor: not-allowed 實際顯示，
           原生 disabled 屬性本身已擋掉點擊/鍵盤觸發，改回 auto 不會讓按鈕變成可點擊（比照新版 EIS 平台 site.css 規則） */
        .btn:disabled,
        .btn.disabled {
            pointer-events: auto;
            cursor: not-allowed;
        }

        /* 匯出中提示視窗：頁面全域字級較小，SweetAlert2 預設的 em 相對單位會被連帶縮小，
           故明確指定固定尺寸與字級，不依賴繼承，確保視窗與文字清楚可讀 */
        .quotesview-export-popup {
            width: 26em !important;
            padding: 1.6em !important;
        }
        .quotesview-export-popup .swal2-title {
            font-size: 1.6rem !important;
        }
        .quotesview-export-popup .swal2-html-container {
            font-size: 1.15rem !important;
        }
    </style>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/sweetalert2.all.min.js"></script>
    <script>
        // 是否已查詢過：未查詢前不可匯出，避免空篩選條件匯出全表資料
        var hasSearched = false;

        // 目前登入者姓名／編號（供報價中 checkbox 等事件使用；從 _QuotePartialView.cshtml 移至此處，
        // 只在整頁載入時宣告一次，避免每次查詢重新載入 partial 時被重複宣告）
        var fName = '@(ViewBag.Name != null ? ViewBag.Name.ToString() : "")';
        var Temp = '@(ViewBag.UserId != null ? ViewBag.UserId.ToString() : "")';
        var uId = Temp.padStart(5, '0');

        $(document).ready(function () {
            // 進入頁面預設禁用匯出，待查詢成功後才解鎖
            $('#exp').prop('disabled', true).attr('title', '請先查詢後再匯出');

            // 使用 AJAX 載入客戶清單 ------------------------------------------------------------------------------------------------
            $.ajax({
                url: '@Url.Action("QuoteCust", "QuoteSchedule")',
                type: 'GET',
                dataType: 'json',
                async: true, // 确保请求是异步的
                success: function(data) {
                    var $custNo = $('#CustNo');
                    $custNo.empty();
                    $.each(data, function(index, item) {
                        $custNo.append($('<option>', {
                            value: item.Value,
                            text : item.Text
                        }));
                    });
                },
                error: function() {
                    alert('無法載入客戶清單');
                }
            });

            // 使用 AJAX 載入業務清單 ------------------------------------------------------------------------------------------------
            $.ajax({
                url: '@Url.Action("QuoteSalesdrop", "QuoteSchedule")',
                type: 'GET',
                dataType: 'json',
                async: true, // 确保请求是异步的
                success: function(data) {
                    var $salesID = $('#SalesID');
                    $salesID.empty();
                    $.each(data, function(index, item) {
                        $salesID.append($('<option>', {
                            value: item.Value,
                            text : item.Text
                        }));
                    });
                },
                error: function() {
                    alert('無法載入業務清單');
                }
            });

            // 查詢按鈕點擊事件 ------------------------------------------------------------------------------------------------
            $('#btnSearch').click(function () {
                $.ajax({
                    url: '@Url.Action("QuotesView", "QuoteSchedule")',
                    type: 'GET',
                    data: {
                        Cancel: $("#Cancel").prop('checked'),
                        SalesID: $("#SalesID").val(),
                        CustNo: $("#CustNo").val(),
                        EngSr: $("#EngSr").val(),
                        CustMaterial: $("#CustMaterial").val(),
                        Sort: $("#Sort").val(),
                        indate: $("#indate").val(),
                        indate2: $("#indate2").val(),
                        btn: "clk"
                    },
                    async: true, // 确保请求是异步的
                    cache: false,
                    success: function (data) {
                        console.log(data);
                        // 更新部分顯示
                        $('#partialViewContainer').html(data);
                        // 查詢成功才解鎖匯出，確保匯出時的篩選條件已實際查詢過
                        hasSearched = true;
                        $('#exp').prop('disabled', false);
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log("Error: " + textStatus + " " + errorThrown);
                    }
                });
            });

            // 當[業務]下拉選單改變時自動觸發查詢 ----------------------------------------------------------------------------------------
            $('#SalesID').change(function () {
                $('#btnSearch').trigger('click');
            });

            // 當[客戶別]下拉選單改變時自動觸發查詢 ----------------------------------------------------------------------------------------
            $('#CustNo').change(function () {
                $('#btnSearch').trigger('click');
            });

            // 當[排序]下拉選單改變時自動觸發查詢 ----------------------------------------------------------------------------------------
            $('#Sort').change(function () {
                $('#btnSearch').trigger('click');
            });

            // 匯出Excel按鈕點擊事件 --------------------------------------------------------------------------------------------
            $('#exp').click(function () {
                // 防禦性二次檢查：未查詢過不可匯出（按鈕本身已用 disabled 擋掉正常點擊）
                if (!hasSearched) {
                    Swal.fire({
                        icon: 'warning', title: '請先查詢', text: '請先設定篩選條件並查詢，再進行匯出，避免匯出全部資料造成檔案過大',
                        customClass: { popup: 'quotesview-export-popup' }
                    });
                    return;
                }
                // 將表單的值設置為當前查詢條件
                $('#exportSalesID').val($("#SalesID").val());
                $('#exportCustNo').val($("#CustNo").val());
                $('#exportSort').val($("#Sort").val());
                $('#exportIndate').val($("#indate").val());
                $('#exportIndate2').val($("#indate2").val());
                $('#exportCancel').val($("#Cancel").prop('checked'));
                $('#exportEngSr').val($("#EngSr").val());
                $('#exportCustMaterial').val($("#CustMaterial").val());
                // 提交表單（傳統表單 GET 送出觸發檔案下載，瀏覽器不會離開當前頁面，
                // 但也沒有 JS 可偵測的「下載完成」事件，故用固定延遲關閉提示視窗，非精確進度）
                Swal.fire({
                    title: '匯出中...', text: '請稍候，正在產生 Excel 檔案',
                    allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false,
                    customClass: { popup: 'quotesview-export-popup' },
                    didOpen: function () { Swal.showLoading(); }
                });
                $('#exportForm').submit();
                setTimeout(function () { Swal.close(); }, 3000);
            });

            // 以下 4 個事件綁定原本寫在 _QuotePartialView.cshtml 內，因該檔案每次查詢都會被 AJAX
            // 整段替換並重新執行其中的 <script>，導致綁定在 document/window 上的委派事件重複疊加、
            // 一次點擊觸發多次請求。搬移至此處，僅在整頁載入時綁定一次。

            // Edit / Cancel / IE Check 連結點擊事件 ------------------------------------------------------------------------
            $(document).on("click", ".seditlink, .cancel-link, .edit-link", function (e) {
                e.preventDefault();
                var Deptno = $(this).closest("tr").data("dept");
                var IEonwer = $(this).closest("tr").data("ieonwer");
                var IEStatus = $(this).closest("tr").data("iestatus");
                var actionType = $(this).hasClass("seditlink") ? "修改" : "取消";

                if (IEStatus == "U" && IEonwer !== fName) {
                    alert("報價中，此單不可操作！");
                    return false;
                }
                if (IEonwer.length == 3 && Deptno == "SD") {
                    alert("IE已報價，此單不可" + actionType + "！");
                } else {
                    if ($(this).hasClass("cancel-link")) {
                        if (confirm("您確定要取消報價嗎?")) {
                            window.location.href = this.href;
                        } else {
                            return false;
                        }
                    } else {
                        window.location.href = this.href;
                    }
                }
            });

            // 「報價中」checkbox 變更事件 -----------------------------------------------------------------------------------
            $(document).on("change", ".handleCheckbox", function () {
                var recordId = $(this).data("record-id");
                var isChecked = $(this).is(":checked");
                var originalState = !isChecked; // 記住操作前的狀態，失敗時還原
                var $checkbox = $(`#handleCheckbox_${recordId}`);
                var $ieowner = $(`#ieowner_${recordId}`);

                $.ajax({
                    url: '@Url.Action("HandleCheckboxChange", "QuoteSchedule")',
                    type: 'POST',
                    data: {
                        sno: recordId,
                        isChecked: isChecked,
                        ieonwerName: fName // 僅供前端顯示，權限判斷由後端以 Session 使用者為準
                    },
                    success: function (response) {
                        if (response.status == "locked") {
                            // 已被其他使用者鎖定，還原 checkbox 並提示
                            Swal.fire({ icon: 'warning', title: '報價中', text: response.message || '該資料已經被其他使用者勾選，報價中！' });
                            $checkbox.prop("checked", originalState);
                        } else if (response.status == "success") {
                            if (isChecked) {
                                // 勾選成功：顯示負責人；checkbox 維持可互動，原勾選者可直接再次點擊取消，不需重整頁面
                                $ieowner.text(response.ieonwer);
                                Swal.fire({ icon: 'success', title: '成功', text: '紀錄已設置為報價中', timer: 1500, showConfirmButton: false });
                            } else {
                                // 取消成功：清空負責人
                                $ieowner.text("");
                                Swal.fire({ icon: 'info', title: '已取消', text: '已取消報價中狀態', timer: 1500, showConfirmButton: false });
                            }
                        } else {
                            // 後端驗證失敗（例如：非原勾選者嘗試取消），還原 checkbox 狀態
                            $checkbox.prop("checked", originalState);
                            Swal.fire({ icon: 'error', title: '無法更新', text: response.message || '無法更新紀錄' });
                        }
                    },
                    error: function () {
                        // AJAX 失敗，還原 checkbox 狀態
                        $checkbox.prop("checked", originalState);
                        Swal.fire({ icon: 'error', title: '錯誤', text: '無法更新紀錄' });
                    }
                });
            });

            // 點擊詳細資料 Modal 以外的地方則關閉 --------------------------------------------------------------------------
            // 每次都重新查找目前的 #detailsModal 節點，避免 partial 重新載入後參照到已被替換的舊節點
            $(window).click(function (event) {
                var $detailsModal = $('#detailsModal');
                if ($(event.target).is($detailsModal)) {
                    $detailsModal.hide();
                }
            });

            // 上傳連結點擊事件，開啟上傳 Modal --------------------------------------------------------------------------
            // 每次都重新查找目前的 #uploadModal 節點，避免 partial 重新載入後參照到已被替換的舊節點
            $(document).on("click", ".upload-link", function (e) {
                e.preventDefault();
                var sno = $(this).data("sno");
                var uploadModal = document.getElementById("uploadModal");
                $("#modalSno").val(sno);
                uploadModal.style.display = "block";
            });
        });
    </script>
</head>

@if (ViewBag.EmailError != null)
{
    <div class="alert alert-danger" role="alert" style="margin-top:20px;">
        @ViewBag.EmailError
    </div>
}
<h2>報價機種一覽</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @if (dept == "SD")
        {
            <div class="form-group">
                @Html.ActionLink("報價機種登記", "QuoteSales", null, new { @class = "btn btn-info" })
            </div>
        }
    </div>
}
<div class="container-fluid" style="text-align: center;">
    <div class="inline-form">
        <label for="SalesID">業務:</label>
        <select id="SalesID" name="SalesID" class="form-control mr-2"></select>

        <label for="CustNo">客戶別:</label>
        <select id="CustNo" name="CustNo" class="form-control mr-2"></select>

        <label for="EngSr">工程編號:</label>
        @Html.TextBox("EngSr", null, new { @class = "form-control mr-2", @id = "EngSr", style = "width: 150px;" })

        <label for="CustMaterial">機種名稱:</label>
        @Html.TextBox("CustMaterial", null, new { @class = "form-control mr-2", @id = "CustMaterial", style = "width: 200px;" })

        <label for="Sort">需求日期 & 排序:</label>
        <select id="Sort" name="Sort" class="form-control mr-2">
            <option value="ASC">日期正排序</option>
            <option value="DESC">日期逆排序</option>
        </select>

        <label for="indate">日期:</label>
        @Html.TextBox("indate", null, new { @type = "date", @class = "form-control mr-2", @id = "indate", @placeholder = "YYYY-MM-DD" })

        <label for="indate2">～</label>
        @Html.TextBox("indate2", null, new { @type = "date", @class = "form-control mr-2", @id = "indate2", @placeholder = "YYYY-MM-DD" })

        <label for="Cancel">Cancel單:</label>
        @Html.CheckBox("Cancel", false, new { @class = "form-check-input", @id = "Cancel", @name = "Cancel" })

        <button type="button" class="btn btn-default" id="btnSearch" name="btnSearch">查詢</button>
    </div>
</div>
<!-- 隱藏的表單，用於匯出 Excel -->
<form id="exportForm" action="@Url.Action("ExportToExcel", "QuoteSchedule")" method="get" style="display:none;">
    <input type="hidden" id="exportSalesID" name="SalesID" />
    <input type="hidden" id="exportCustNo" name="CustNo" />
    <input type="hidden" id="exportSort" name="Sort" />
    <input type="hidden" id="exportIndate" name="Indate" />
    <input type="hidden" id="exportIndate2" name="Indate2" />
    <input type="hidden" id="exportCancel" name="Cancel" />
    <input type="hidden" id="exportEngSr" name="EngSr" />
    <input type="hidden" id="exportCustMaterial" name="CustMaterial" />
</form>
<p><button type="button" class="btn btn-link" id="exp" name="exp">匯出Excel</button></p>
<div id="partialViewContainer">
    @Html.Partial("_QuotePartialView", Model)
</div>

